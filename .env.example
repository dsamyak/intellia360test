# Copy to .env.local and fill in real values. Never commit secrets.

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=mongodb+srv://user:password@cluster.mongodb.net/intellia360

# ─── Authentication ──────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
AUTH_JWT_SECRET=change-me-to-a-long-random-string
AUTH_JWT_EXPIRES_IN=7d

# NestJS backend JWT (used by src/config/configuration.ts)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRATION=1d

# ─── Application ─────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Email — Resend (Password Reset) ─────────────────────────────────────────
# Get your API key at https://resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Without a verified domain use: "Intellia360 <onboarding@resend.dev>" (testing only)
RESEND_FROM=Intellia360 <onboarding@resend.dev>
