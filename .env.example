# Copy to .env.local (or .env) and fill in real values.

# postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/intellia360

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

PORT=3000
NODE_ENV=development

# Comma-separated list of allowed frontend origins once a frontend exists.
# Leave unset during Week 1 — CORS defaults to open so any dev frontend
# (Vite, Next.js, etc.) can connect without extra config.
# FRONTEND_URL=http://localhost:5173,http://localhost:3001
