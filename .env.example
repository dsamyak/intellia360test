# Copy to .env.local and fill in real values. Never commit secrets.

# ─── Database ────────────────────────────────────────────────────────────────
# MongoDB Atlas (recommended) or local MongoDB via docker-compose.yml
DATABASE_URL=mongodb+srv://user:password@cluster.mongodb.net/intellia360

# ─── JWT Authentication ──────────────────────────────────────────────────────
# Generate a strong secret:
#   node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
AUTH_JWT_SECRET=change-me-to-a-long-random-string-at-least-64-chars
AUTH_JWT_EXPIRES_IN=7d

# ─── Application URLs ────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ─── Email — Resend ───────────────────────────────────────────────────────────
# Sign up free at https://resend.com
# Without a verified domain, use:  Intellia360 <onboarding@resend.dev>
# With a verified domain, use:     Intellia360 <noreply@yourdomain.com>
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=Intellia360 <onboarding@resend.dev>
