# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/intellia360

# ─── Authentication ─────────────────────────────────────────────────────────
AUTH_JWT_SECRET=your-super-secret-jwt-key-change-this
AUTH_JWT_EXPIRES_IN=7d

# ─── Application ────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Email — Resend (Password Reset) ─────────────────────────────────────────
# Get your API key at https://resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Without a verified domain use: "Intellia360 <onboarding@resend.dev>" (testing only)
RESEND_FROM=Intellia360 <noreply@yourdomain.com>
