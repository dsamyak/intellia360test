// Prisma schema for Intellia360 — MongoDB
// Aligned with origin/main schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  STUDENT
  PARENT
  TEACHER
  SCHOOL
  EDITOR
}

enum AssignmentStatus {
  ACTIVE
  DRAFT
  COMPLETED
}

enum SchoolStatus {
  ACTIVE
  PENDING
  INACTIVE
}

enum CourseStatus {
  PUBLISHED
  DRAFT
}

enum PaymentStatus {
  COMPLETED
  PENDING
  REFUNDED
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(uuid()) @map("_id")
  email         String   @unique
  name          String
  password      String
  role          Role     @default(STUDENT)
  requestedRole Role?                          // intent set at registration; reviewed by admin
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  studentProfile      StudentProfile?
  teacherProfile      TeacherProfile?
  completedLessons    CompletedLesson[]
  completedActivities CompletedActivity[]
  unlockedBadges      UnlockedBadge[]
  missionProgress     MissionProgress[]
  quizAttempts        QuizAttempt[]
  submissions         AssignmentSubmission[]
  resetTokens         PasswordResetToken[]
  verifyTokens        EmailVerificationToken[]
  dailyQuizAttempts   DailyQuizAttempt[]
  notifications       Notification[]

  @@index([role])
  @@map("users")
}

// ─── Profiles ─────────────────────────────────────────────────────────────────

model StudentProfile {
  id             String      @id @default(uuid()) @map("_id")
  userId         String      @unique
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatar         String?
  school         String?
  grade          String      @default("grade1")
  xpPoints       Int         @default(0)
  learningGems   Int         @default(0)
  streakDays     Int         @default(1)
  lastActiveDate DateTime?
  classId        String?
  class          ClassGroup? @relation(fields: [classId], references: [id])
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([classId])
  @@map("student_profiles")
}

model TeacherProfile {
  id         String       @id @default(uuid()) @map("_id")
  userId     String       @unique
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatar     String?
  schoolName String?
  subject    String?
  classes    ClassGroup[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@map("teacher_profiles")
}

// ─── Classes ──────────────────────────────────────────────────────────────────

model ClassGroup {
  id          String           @id @default(uuid()) @map("_id")
  className   String
  grade       String
  teacherId   String
  teacher     TeacherProfile   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  students    StudentProfile[]
  assignments Assignment[]
  createdAt   DateTime         @default(now())

  @@index([teacherId])
  @@map("class_groups")
}

// ─── Student Progress ─────────────────────────────────────────────────────────

model CompletedLesson {
  id          String   @id @default(uuid()) @map("_id")
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  grade       String
  completedAt DateTime @default(now())

  @@unique([userId, lessonId])
  @@index([userId])
  @@map("completed_lessons")
}

model CompletedActivity {
  id           String   @id @default(uuid()) @map("_id")
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId     String
  activityType String
  xpAwarded    Int      @default(0)
  gemsAwarded  Int      @default(0)
  completedAt  DateTime @default(now())

  @@unique([userId, lessonId, activityType])
  @@index([userId])
  @@map("completed_activities")
}

model UnlockedBadge {
  id         String   @id @default(uuid()) @map("_id")
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId    String
  unlockedAt DateTime @default(now())

  @@unique([userId, badgeId])
  @@index([userId])
  @@map("unlocked_badges")
}

model MissionProgress {
  id          String    @id @default(uuid()) @map("_id")
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  missionId   String
  progress    Int       @default(0)
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([userId, missionId])
  @@index([userId])
  @@map("mission_progress")
}

model QuizAttempt {
  id           String   @id @default(uuid()) @map("_id")
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId     String
  quizId       String
  scorePercent Int
  submittedAt  DateTime @default(now())

  @@index([userId])
  @@index([lessonId])
  @@map("quiz_attempts")
}

// ─── Assignments ──────────────────────────────────────────────────────────────

model Assignment {
  id           String                 @id @default(uuid()) @map("_id")
  title        String
  classId      String
  class        ClassGroup             @relation(fields: [classId], references: [id], onDelete: Cascade)
  lessonId     String?
  assignedDate DateTime               @default(now())
  dueDate      DateTime
  status       AssignmentStatus       @default(ACTIVE)
  submissions  AssignmentSubmission[]

  @@index([classId])
  @@map("assignments")
}

model AssignmentSubmission {
  id           String     @id @default(uuid()) @map("_id")
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  submittedAt  DateTime?
  scorePercent Int?

  @@unique([assignmentId, studentId])
  @@map("assignment_submissions")
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id          String   @id @default(uuid()) @map("_id")
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   // "achievement" | "lesson" | "quiz" | "streak" | "xp" | "announcement"
  tabCategory String   // "achievements" | "learning" | "announcements"
  icon        String
  iconBg      String
  title       String
  description String
  categoryTag String
  actionUrl   String?
  actionText  String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([userId, isRead])
  @@map("notifications")
}

// ─── Daily Quiz ───────────────────────────────────────────────────────────────
// One attempt per user per UTC day. Stores per-question answers and rewards.

model DailyQuizAttempt {
  id            String   @id @default(uuid()) @map("_id")
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateKey       String                        // "YYYY-MM-DD" UTC — unique per user per day
  grade         String
  questions     Json                          // snapshot of questions served that day
  answers       Json                          // { questionId: selectedOptionId }[]
  score         Int                           // 0-5 (number correct)
  xpAwarded     Int      @default(0)
  gemsAwarded   Int      @default(0)
  streakDay     Int                           // streakDays value at time of completion
  completedAt   DateTime @default(now())

  @@unique([userId, dateKey])
  @@index([userId])
  @@index([dateKey])
  @@map("daily_quiz_attempts")
}

// ─── Rate Limit Record ────────────────────────────────────────────────────────
// Tracks recent request counts per (key, action) to enforce server-side
// rate limits that survive across serverless function instances (no in-memory).
//
// key    = SHA-256(ip) or SHA-256(email) — never store raw PII in this table.
// action = e.g. "login", "resend_verification", "forgot_password"

model RateLimitRecord {
  id        String   @id @default(uuid()) @map("_id")
  key       String                          // hashed identifier
  action    String                          // action name
  count     Int      @default(1)
  windowStart DateTime                      // start of the current window
  updatedAt DateTime @updatedAt

  @@unique([key, action])
  @@index([key])
  @@index([windowStart])
  @@map("rate_limit_records")
}

// ─── Email Verification Token ─────────────────────────────────────────────────
// tokenHash stores SHA-256(raw_token) — the raw token is sent by email only.
// On verify we hash the submitted token and compare, never storing it plaintext.

model EmailVerificationToken {
  id        String   @id @default(uuid()) @map("_id")
  tokenHash String   @unique          // SHA-256 of the raw token
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

// ─── Password Reset Token (Next.js auth layer) ────────────────────────────────
// tokenHash stores SHA-256(raw_token) — same pattern as email verification.

model PasswordResetToken {
  id        String   @id @default(uuid()) @map("_id")
  tokenHash String   @unique          // SHA-256 of the raw token
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ─── Admin: Schools ───────────────────────────────────────────────────────────

model School {
  id             String       @id @default(uuid()) @map("_id")
  name           String
  code           String       @unique
  location       String?
  adminName      String?
  adminEmail     String?
  plan           String       @default("Basic")
  status         SchoolStatus @default(PENDING)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("schools")
}

// ─── Admin: Courses ───────────────────────────────────────────────────────────

model Course {
  id               String       @id @default(uuid()) @map("_id")
  title            String
  subject          String?
  grade            String
  description      String?
  rating           Float        @default(0)
  status           CourseStatus @default(DRAFT)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@map("courses")
}

// ─── Admin: Content Library (metadata + external resource link) ──────────────

model ContentResource {
  id          String   @id @default(uuid()) @map("_id")
  title       String
  description String?
  category    String   // "edunotes" | "visual-models" | "videos" | "ai-prompts"
  url         String?  // external resource link (no binary storage provider configured)
  createdAt   DateTime @default(now())

  @@index([category])
  @@map("content_resources")
}

// ─── Admin: Payments ──────────────────────────────────────────────────────────

model Payment {
  id            String        @id @default(uuid()) @map("_id")
  transactionId String        @unique
  payerName     String
  schoolOrUser  String?
  amount        Int           // in rupees
  method        String        @default("Manual")
  status        PaymentStatus @default(PENDING)
  date          DateTime      @default(now())
  createdAt     DateTime      @default(now())

  @@map("payments")
}

// ─── Admin: Platform Settings (singleton) ─────────────────────────────────────

model AdminSettings {
  id                     String   @id @default("global") @map("_id")
  platformName           String   @default("")
  supportEmail           String   @default("")
  academicYear           String   @default("")
  primaryColor           String   @default("#f97316")
  logoDisplay            String   @default("badge-text")
  emailSchoolRegistration Boolean @default(false)
  emailWeeklySummary     Boolean  @default(false)
  emailRenewalAlert      Boolean  @default(false)
  twoFactor              String   @default("mandatory")
  sessionTimeoutMinutes  Int      @default(30)
  aiModel                String   @default("fast")
  dailyQueries           Int      @default(0)
  updatedAt              DateTime @updatedAt

  @@map("admin_settings")
}
